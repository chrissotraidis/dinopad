{
  "schema_version": 2,
  "id": "dinopad",
  "name": "DinoPad",
  "game": "Dinosaur Planet (N64, December 2000 prototype) via dino-recomp",
  "kind": "disc-translation",
  "status": "draft-untested",
  "inputs": [
    {
      "type": "n64-rom",
      "formats": [
        "z64",
        "v64",
        "n64"
      ],
      "when": "build",
      "description": "Your own unmodified December 2000 Dinosaur Planet prototype ROM (MD5 49f7bb346ade39d1915c22e090ffd748), normalized and translated privately during the build."
    }
  ],
  "targets": {
    "ios": {
      "hosts": {
        "macos-arm64": "experimental",
        "windows-arm64": "experimental",
        "windows-x86_64": "experimental"
      },
      "output": "ipa",
      "check": "ipa",
      "steps": [
        {
          "stage": "dependencies",
          "command": [
            "{repo}/scripts/bootstrap.sh"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "preflight",
          "command": [
            "{repo}/scripts/check-repo-safety.sh"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "tools",
          "command": [
            "{repo}/scripts/build-tools.sh"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "translate",
          "command": [
            "{repo}/scripts/generate-base.sh",
            "--rom",
            "{disc}"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "host-shaders",
          "command": [
            "cmake",
            "-S",
            "{repo}",
            "-B",
            "{repo}/build-macos",
            "-G",
            "Ninja",
            "-DCMAKE_BUILD_TYPE=Release",
            "-DDINOPAD_ENABLE_STATIC_RESTORATION=OFF"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "host-build",
          "command": [
            "cmake",
            "--build",
            "{repo}/build-macos",
            "--target",
            "file_to_c",
            "spirv_cross_msl"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "compile",
          "command": [
            "{repo}/scripts/build-ios-device.sh",
            "--distribution",
            "base"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "package",
          "command": [
            "{repo}/scripts/package-ios.sh",
            "--candidate",
            "--distribution",
            "base",
            "--output",
            "{output}"
          ],
          "on": [
            "macos"
          ]
        },
        {
          "stage": "compile",
          "on": [
            "windows"
          ],
          "command": [
            "{python}",
            "{repo}/scripts/build-game-module.py",
            "--rom",
            "{disc}",
            "--toolchain",
            "{ios_toolchain}",
            "--build-dir",
            "{work}",
            "--jobs",
            "{jobs}"
          ]
        }
      ],
      "tools": [
        "git",
        "cmake",
        "ninja",
        "llvm",
        "libcxx",
        "mips-clang"
      ],
      "published_app": "DinoPad-v{version}-ios-shell.ipa",
      "ios_module": {
        "on": [
          "windows"
        ],
        "file": "{work}/module/DinoPadGame.dylib",
        "into": "DinoPadGame.dylib"
      }
    },
    "macos": {
      "hosts": {
        "macos-arm64": "planned"
      }
    }
  },
  "requirements": {
    "disk_gb": 25,
    "tools": [
      {
        "name": "git",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "cmake",
        "version_args": [
          "--version"
        ],
        "min_version": "3.24",
        "player": true,
        "note": "Install CMake 3.24 or newer: brew install cmake. DinoPad's pinned SDL2 Apple build requires it."
      },
      {
        "name": "ninja",
        "version_args": [
          "--version"
        ],
        "player": true,
        "note": "Install Ninja before building DinoPad: brew install ninja."
      },
      {
        "name": "python3",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "make",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "xcodebuild",
        "version_args": [
          "-version"
        ],
        "note": "Install Xcode and its iOS platform"
      },
      {
        "name": "xcrun",
        "label": "Metal Toolchain",
        "version_args": [
          "metal",
          "--version"
        ],
        "player": true,
        "note": "Install Xcode's Metal Toolchain: xcodebuild -downloadComponent MetalToolchain"
      },
      {
        "name": "rg",
        "version_args": [
          "--version"
        ],
        "note": "ripgrep, used by the packaging checks: brew install ripgrep"
      },
      {
        "name": "%ProgramFiles(x86)%/Microsoft Visual Studio/Installer/vswhere.exe",
        "version_args": [
          "-latest",
          "-products",
          "*",
          "-requiresAny",
          "-requires",
          "Microsoft.VisualStudio.Component.VC.Tools.x86.x64",
          "Microsoft.VisualStudio.Component.VC.Tools.ARM64",
          "-property",
          "installationVersion"
        ],
        "min_version": "17",
        "player": true,
        "hosts": [
          "windows-arm64"
        ],
        "label": "Visual Studio C++ Build Tools",
        "note": "Install Visual Studio 2022 Build Tools with Desktop development with C++ and a Windows SDK. On Windows ARM64, add the ARM64 C++ tools (preferred) or the x64/x86 C++ tools."
      },
      {
        "name": "%ProgramFiles(x86)%/Microsoft Visual Studio/Installer/vswhere.exe",
        "version_args": [
          "-latest",
          "-products",
          "*",
          "-requires",
          "Microsoft.VisualStudio.Component.VC.Tools.x86.x64",
          "-property",
          "installationVersion"
        ],
        "min_version": "17",
        "player": true,
        "hosts": [
          "windows-x86_64"
        ],
        "label": "Visual Studio C++ Build Tools",
        "note": "Install Visual Studio 2022 Build Tools with Desktop development with C++, x64/x86 C++ tools and a Windows SDK."
      }
    ]
  },
  "notes": "Builds the base (Prototype Mode) edition following README: bootstrap, tools, generate-base from the player's ROM, native host shader tools, device build, candidate package. The Restored edition needs DinoMod's private asset environment and permission terms and is not driven by PadMint. A MIPS-targeting Clang is required (PATCHES_C_COMPILER; see docs/BUILDING.md).",
  "publication": {
    "public_binaries": false,
    "reason": "Personal builds contain game code translated from the player's ROM; public releases are source only."
  }
}

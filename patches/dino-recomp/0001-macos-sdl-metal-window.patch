diff --git a/src/runtime/gfx.cpp b/src/runtime/gfx.cpp
--- a/src/runtime/gfx.cpp
+++ b/src/runtime/gfx.cpp
@@ -9,9 +9,26 @@
 
 #include "../../lib/rt64/src/contrib/stb/stb_image.h"
 
+#if defined(__APPLE__)
+#include <SDL_metal.h>
+#include <TargetConditionals.h>
+#if TARGET_OS_IPHONE
+extern "C" void dinopad_prepare_gameplay_window(void* window_pointer);
+extern "C" void dinopad_prepare_gameplay_teardown(void* window_pointer);
+extern "C" void dinopad_touch_attach(void* window_pointer);
+#endif
+#endif
+
 namespace dino::runtime {
 
+constexpr Uint32 kSDLSubsystems =
+    SDL_INIT_VIDEO | SDL_INIT_GAMECONTROLLER | SDL_INIT_JOYSTICK | SDL_INIT_HAPTIC;
+
 static SDL_Window* window;
+static bool sdl_initialized;
+#if defined(__APPLE__)
+static SDL_MetalView metal_view;
+#endif
 
 ultramodern::gfx_callbacks_t::gfx_data_t create_gfx() {
     SDL_SetHint(SDL_HINT_WINDOWS_DPI_AWARENESS, "permonitorv2");
@@ -21,9 +37,10 @@ ultramodern::gfx_callbacks_t::gfx_data_t create_gfx() {
     SDL_SetHint(SDL_HINT_MOUSE_FOCUS_CLICKTHROUGH, "1");
     SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
 
-    if (SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMECONTROLLER | SDL_INIT_JOYSTICK | SDL_INIT_HAPTIC) > 0) {
+    if (SDL_Init(kSDLSubsystems) < 0) {
         exit_error("Failed to initialize SDL2: %s\n", SDL_GetError());
     }
+    sdl_initialized = true;
 
     fprintf(stdout, "SDL Video Driver: %s\n", SDL_GetCurrentVideoDriver());
 
@@ -86,6 +103,10 @@ bool SetImageAsIcon(const char* filename, SDL_Window* window)
 ultramodern::renderer::WindowHandle create_window(ultramodern::gfx_callbacks_t::gfx_data_t, int width, int height) {
     uint32_t flags = SDL_WINDOW_RESIZABLE;
 
+#if defined(__APPLE__)
+    flags |= SDL_WINDOW_METAL;
+#endif
+
 #if defined(RT64_SDL_WINDOW_VULKAN)
     flags |= SDL_WINDOW_VULKAN;
 #endif
@@ -112,6 +134,29 @@ ultramodern::renderer::WindowHandle create_window(ultramodern::gfx_callbacks_t::
     return ultramodern::renderer::WindowHandle{ wmInfo.info.win.window, GetCurrentThreadId() };
 #elif defined(__linux__) || defined(__ANDROID__)
     return ultramodern::renderer::WindowHandle{ window };
+#elif defined(__APPLE__)
+    // Port of the PaperPad macOS window path: RT64 expects the NSWindow plus
+    // the window's CAMetalLayer as WindowHandle{window, view}.
+    metal_view = SDL_Metal_CreateView(window);
+    if (metal_view == nullptr) {
+        exit_error("Failed to create Metal view: %s\n", SDL_GetError());
+    }
+    SDL_ShowWindow(window);
+    SDL_SetWindowTitle(window, "DinoPad");
+#if TARGET_OS_IPHONE
+    dinopad_prepare_gameplay_window(wmInfo.info.uikit.window);
+    int pixel_width = 0;
+    int pixel_height = 0;
+    SDL_GetWindowSizeInPixels(window, &pixel_width, &pixel_height);
+    std::fprintf(stderr,
+        "[dinopad-gfx] window created logical=%dx%d pixels=%dx%d\n",
+        width, height, pixel_width, pixel_height);
+    std::fflush(stderr);
+    dinopad_touch_attach(wmInfo.info.uikit.window);
+    return ultramodern::renderer::WindowHandle{ wmInfo.info.uikit.window, SDL_Metal_GetLayer(metal_view) };
+#else
+    return ultramodern::renderer::WindowHandle{ wmInfo.info.cocoa.window, SDL_Metal_GetLayer(metal_view) };
+#endif
 #else
     static_assert(false && "Unimplemented");
 #endif
@@ -121,6 +163,38 @@ SDL_Window *get_window() {
     return window;
 }
 
+void destroy_window() {
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+    if (window != nullptr) {
+        SDL_SysWMinfo wmInfo;
+        SDL_VERSION(&wmInfo.version);
+        if (SDL_GetWindowWMInfo(window, &wmInfo) == SDL_TRUE) {
+            dinopad_prepare_gameplay_teardown(wmInfo.info.uikit.window);
+        }
+    }
+#endif
+#if defined(__APPLE__)
+    if (metal_view != nullptr) {
+        SDL_Metal_DestroyView(metal_view);
+        metal_view = nullptr;
+    }
+#endif
+    if (window != nullptr) {
+        SDL_DestroyWindow(window);
+        window = nullptr;
+    }
+}
+
+void shutdown_gfx() {
+    destroy_window();
+    if (sdl_initialized) {
+        SDL_QuitSubSystem(kSDLSubsystems);
+        sdl_initialized = false;
+        std::fprintf(stderr, "[dinopad-gfx] SDL gameplay subsystems stopped\n");
+        std::fflush(stderr);
+    }
+}
+
 void update_gfx(void*) {
     dino::input::handle_events();
 }
diff --git a/src/runtime/gfx.hpp b/src/runtime/gfx.hpp
--- a/src/runtime/gfx.hpp
+++ b/src/runtime/gfx.hpp
@@ -7,6 +7,8 @@ namespace dino::runtime {
 ultramodern::gfx_callbacks_t::gfx_data_t create_gfx();
 ultramodern::renderer::WindowHandle create_window(ultramodern::gfx_callbacks_t::gfx_data_t, int width, int height);
 SDL_Window *get_window();
+void destroy_window();
+void shutdown_gfx();
 void update_gfx(void*);
 
 }

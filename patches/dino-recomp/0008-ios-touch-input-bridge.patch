+// Every attached controller drives Player 1, the player touch input drives.
+// Touch auto-hides only while one of them has the stick and buttons gameplay
+// needs, so removing one of several controllers keeps the others counted.
+static int dinopad_controller_can_play() {
+    for (const auto& [id, state] : InputState.controller_states) {
+        SDL_GameController* pad = state.controller;
+        if (pad != nullptr && SDL_GameControllerGetAttached(pad) &&
+            SDL_GameControllerHasAxis(pad, SDL_CONTROLLER_AXIS_LEFTX) &&
+            SDL_GameControllerHasAxis(pad, SDL_CONTROLLER_AXIS_LEFTY) &&
+            SDL_GameControllerHasButton(pad, SDL_CONTROLLER_BUTTON_A) &&
+            SDL_GameControllerHasButton(pad, SDL_CONTROLLER_BUTTON_B) &&
+            SDL_GameControllerHasButton(pad, SDL_CONTROLLER_BUTTON_START)) {
+            return 1;
+        }
+    }
+    return 0;
+}
+#endif

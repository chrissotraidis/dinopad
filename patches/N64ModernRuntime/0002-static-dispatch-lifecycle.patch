 void recomp::mods::ModContext::unload_mods() {
+    for (size_t mod_index : loaded_code_mods) {
+        if (opened_mods[mod_index].code_handle != nullptr) {
+            opened_mods[mod_index].code_handle->deactivate_static_dispatch();
